# --- LLM (OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o

# --- Google search via Serper (https://serper.dev) ---
SERPER_API_KEY=

# --- X.com lead search via Groq (https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

# --- GCC Index (logged-in events page) ---
GCCINDEX_USERNAME=
GCCINDEX_PASSWORD=

# --- Email (Gmail SMTP + App Password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
TO_EMAIL=

# --- LangSmith tracing (optional) ---
# Set LANGSMITH_TRACING=true and add a key from https://smith.langchain.com to see every run's trace.
# Traces contain the text sent to the LLM; add LANGSMITH_HIDE_INPUTS=true / LANGSMITH_HIDE_OUTPUTS=true to hide it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gcc-india-weekly

# --- Behaviour ---
LOOKBACK_DAYS=14
SEND_EMPTY_REPORT=true
INCLUDE_ANNOUNCED=true
# Comma list to disable sources: serper,groq_x,et_gcc,gcc_pulse,moneycontrol,gccindex
DISABLED_SOURCES=
