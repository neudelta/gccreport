<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ subject }}</title>
<style>
  /* Progressive enhancement only: the inline styles below already work without this. */
  @media only screen and (max-width: 480px) {
    .wrap { padding: 8px 4px !important; }
    .px { padding-left: 12px !important; padding-right: 12px !important; }
    .kpi { padding-right: 16px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f3f5f8;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1c2733;-webkit-text-size-adjust:100%;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5f8;"><tr><td align="center" class="wrap" style="padding:16px 8px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:720px;background:#ffffff;border-radius:8px;overflow:hidden;">

  <tr><td class="px" style="background:#12355b;padding:20px 20px;">
    <div style="color:#9fb8d6;font-size:12px;letter-spacing:1px;text-transform:uppercase;">GCC India Weekly</div>
    <div style="color:#ffffff;font-size:22px;font-weight:600;line-height:1.25;margin-top:4px;">
      {% if items %}New GCCs &amp; expansions in India{% else %}No new GCC activity this week{% endif %}
    </div>
    <div style="color:#c9d8ea;font-size:13px;margin-top:6px;">{{ window_start }} &ndash; {{ window_end }}</div>
  </td></tr>

  <tr><td class="px" style="padding:20px 20px 8px 20px;">
    <p style="margin:0 0 14px 0;font-size:15px;line-height:1.55;">{{ summary }}</p>
    {% if items %}
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
      <td class="kpi" style="padding-right:26px;"><div style="font-size:26px;font-weight:600;color:#12355b;">{{ new_count }}</div><div style="font-size:12px;color:#5b6b7c;">New GCCs</div></td>
      <td class="kpi" style="padding-right:26px;"><div style="font-size:26px;font-weight:600;color:#12355b;">{{ expansion_count }}</div><div style="font-size:12px;color:#5b6b7c;">Expansions</div></td>
      <td><div style="font-size:26px;font-weight:600;color:#12355b;">{{ city_count }}</div><div style="font-size:12px;color:#5b6b7c;">Cities</div></td>
    </tr></table>
    {% endif %}
  </td></tr>

  {% for it in items %}
  {# One card per item. Stacked blocks (no side-by-side columns) so nothing can overlap on a phone. #}
  <tr><td class="px" style="padding:10px 20px 2px 20px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e3e8ee;border-radius:8px;">
      <tr><td style="padding:14px 14px 6px 14px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
          <td valign="top" style="font-size:17px;font-weight:600;line-height:1.3;color:#1c2733;word-break:break-word;">{{ it.company }}</td>
          <td valign="top" align="right" style="padding-left:10px;white-space:nowrap;">
            <span style="display:inline-block;padding:3px 10px;border-radius:10px;font-size:12px;color:#ffffff;background:{% if it.event_type == 'new_gcc' %}#1b7f5c{% else %}#b26a00{% endif %};">{% if it.event_type == 'new_gcc' %}New GCC{% else %}Expansion{% endif %}</span>
            {% if it.status != 'opened' %}<div style="font-size:11px;color:#5b6b7c;margin-top:3px;">{{ it.status|capitalize }}</div>{% endif %}
          </td>
        </tr></table>
      </td></tr>
      {% if it.summary %}
      <tr><td style="padding:0 14px 10px 14px;font-size:14px;line-height:1.5;color:#3a4a5a;">{{ it.summary }}</td></tr>
      {% endif %}
      <tr><td style="padding:0 14px 14px 14px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.45;">
          <tr>
            <td width="76" valign="top" style="padding:4px 0;color:#5b6b7c;">Location</td>
            <td valign="top" style="padding:4px 0;">{{ it.city }}{% if it.state %}, {{ it.state }}{% endif %}<div style="color:#5b6b7c;font-size:13px;">{{ it.sector }}</div></td>
          </tr>
          <tr>
            <td width="76" valign="top" style="padding:4px 0;color:#5b6b7c;">Date</td>
            <td valign="top" style="padding:4px 0;">{{ it.event_date }}</td>
          </tr>
          <tr>
            <td width="76" valign="top" style="padding:4px 0;color:#5b6b7c;">Source</td>
            <td valign="top" style="padding:4px 0;word-break:break-word;"><a href="{{ it.source_url }}" style="color:#0b5cad;">{{ it.source_label }}</a>{% if it.source_host %}<span style="color:#5b6b7c;font-size:13px;"> &middot; {{ it.source_host }}</span>{% endif %}</td>
          </tr>
        </table>
      </td></tr>
    </table>
  </td></tr>
  {% endfor %}

  {% if items and chart_cid %}
  <tr><td class="px" align="center" style="padding:22px 20px 8px 20px;">
    <div style="font-size:15px;font-weight:600;margin-bottom:8px;">Sector mix</div>
    <img src="cid:{{ chart_cid }}" alt="Sector distribution pie chart" width="360" style="width:100%;max-width:360px;height:auto;display:block;margin:0 auto;">
  </td></tr>
  {% endif %}

  {% if already_reported_count %}
  <tr><td class="px" style="padding:20px 20px 22px 20px;border-top:1px solid #e3e8ee;">
    <div style="font-size:12px;color:#5b6b7c;line-height:1.6;">
      {{ already_reported_count }} item(s) found this week were already reported earlier and were excluded.
    </div>
  </td></tr>
  {% else %}
  <tr><td style="padding:12px;font-size:1px;line-height:1px;">&nbsp;</td></tr>
  {% endif %}
</table>
</td></tr></table>
</body></html>
